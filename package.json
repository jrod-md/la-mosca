{
  "name": "la-mosca",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/run-ts.mjs scripts/og-image.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "sync:matches": "node scripts/run-ts.mjs scripts/sync-matches.ts",
    "fetch:history": "node scripts/run-ts.mjs scripts/fetch-history.ts",
    "calibrate:odds": "node scripts/run-ts.mjs scripts/calibrate-odds.ts",
    "fly:raise": "node scripts/run-ts.mjs scripts/raise-fly.ts",
    "fly:daily": "node scripts/run-ts.mjs scripts/fly-daily.ts",
    "fly:upcoming": "node scripts/run-ts.mjs scripts/fly-daily.ts --upcoming-only",
    "calibrate:international": "node scripts/run-ts.mjs scripts/calibrate-international.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
